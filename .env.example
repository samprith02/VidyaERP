# ── VidyaERP configuration ────────────────────────────────────────────────────
#
#   cp .env.example .env     and fill in LLM_API_KEY
#
# Every value here is optional. With no .env at all the app still runs: db.seed()
# builds the whole institution into SQLite on first import and the deterministic
# rule engine answers every query offline, at zero cost. A key only switches the
# copilot to the LLM agent — behind exactly the same guardrails.
#
# .env is gitignored and must stay that way. For a deployment, set these as real
# environment variables instead (Render does it from render.yaml + the dashboard);
# the real environment takes precedence over this file.

# ── LLM: any OpenAI-compatible /chat/completions endpoint ────────────────────
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Groq meters quota PER MODEL, so a fallback chain multiplies usable throughput
# instead of dropping the admin onto the rule engine mid-conversation. Tried in
# order, on 429 / 5xx only.
#
# Every id here must (a) still be served and (b) support TOOL CALLING — the
# agent loop is nothing but tool calls, so a chat-only model answers HTTP 400
# "tool calling is not supported" and burns the hop. groq/compound-mini is one
# such. Confirm against console.groq.com/docs/models before changing this:
# llama-3.3-70b-versatile sat here until it was retired, which turned the last
# hop into a dead end that exhausted the chain into the rule engine under
# exactly the rate-limit pressure it existed to absorb.
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Tuning
LLM_TEMPERATURE=0.35
LLM_MAX_TOKENS=1400
LLM_TIMEOUT=60

# ── Deployment ───────────────────────────────────────────────────────────────
# The console has NO LOGIN — anyone who can reach the URL is the Registrar.
# This token protects the two endpoints that are operator controls rather than
# console features: /api/seed/reset and /api/mcp/approval. Leave it blank on a
# laptop; set it (any long random string) for anything reachable by others.
VIDYAERP_ADMIN_TOKEN=

# Where college.db lives. Default is beside the code. Point this at a mounted
# disk on a host with an ephemeral filesystem, or every applied override is
# rebuilt from the seed on the next restart.
# VIDYAERP_DB=/var/data/college.db

# ── Ready-made presets — copy one over the LLM_BASE_URL / LLM_MODEL lines ────
# Groq (fast)   LLM_BASE_URL=https://api.groq.com/openai/v1         LLM_MODEL=openai/gpt-oss-120b
# OpenAI        LLM_BASE_URL=https://api.openai.com/v1              LLM_MODEL=gpt-4o-mini
# OpenRouter    LLM_BASE_URL=https://openrouter.ai/api/v1           LLM_MODEL=google/gemini-2.0-flash-001
# Together      LLM_BASE_URL=https://api.together.xyz/v1            LLM_MODEL=Qwen/Qwen2.5-72B-Instruct-Turbo
# DeepSeek      LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL=deepseek-chat
# Gemini (compat) LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                                                                   LLM_MODEL=gemini-2.0-flash
# Ollama (local, no key) LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=qwen2.5:14b
